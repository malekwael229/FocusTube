{
  "name": "focustube",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:regression": "node tests/regression.test.js",
    "test:background": "node tests/background-timer.test.js",
    "test:smoke": "node tests/playwright-smoke.test.js",
    "test:smoke:youtube": "node tests/playwright-smoke.test.js --youtube",
    "test:package": "node tests/package-reproducibility.test.js",
    "test:localization": "node tests/localization.test.js",
    "test:website": "node tests/website-validation.test.js",
    "test:security": "node --test tests/tooling-security.test.js",
    "test:fuzz": "node --test tests/property-security.test.js",
    "test:feeds": "node tests/feed-filters.test.js",
    "test:syntax": "node scripts/run-test-all.js --syntax",
    "test:live": "node tests/live-browser.test.js",
    "test:live:harness": "node --test tests/live/report.test.js tests/live/site-checks.test.js",
    "test:all": "node scripts/run-test-all.js"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "web-ext": {
      "fx-runner": "1.7.0"
    }
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "playwright": "1.63.0",
    "web-ext": "10.7.0"
  }
}

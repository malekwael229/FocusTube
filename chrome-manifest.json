{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "2.5.2",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "permissions": ["storage", "alarms", "notifications", "scripting"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.facebook.com/*",
    "*://*.linkedin.com/*"
  ],
  "optional_host_permissions": ["*://reddit.com/*", "*://www.reddit.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "exclude_matches": ["*://music.youtube.com/*", "*://studio.youtube.com/*"],
      "css": ["content.css"],
      "js": ["i18n.js", "content-common.js", "content-yt.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "css": ["content.css"],
      "js": ["i18n.js", "content-common.js", "content-ig.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.tiktok.com/*"],
      "css": ["content.css"],
      "js": ["i18n.js", "content-common.js", "content-tt.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.facebook.com/*"],
      "exclude_matches": ["*://business.facebook.com/*", "*://developers.facebook.com/*"],
      "css": ["content.css"],
      "js": ["i18n.js", "content-common.js", "content-fb.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.linkedin.com/*"],
      "css": ["content.css"],
      "js": ["i18n.js", "content-common.js", "content-li.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
